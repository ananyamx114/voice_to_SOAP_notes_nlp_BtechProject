# Example only. The CLI does not automatically load .env files.
# In bash: set -a; source .env; set +a
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
HF_HOME=data/models/huggingface
# Local Ollama uses the client's placeholder key; no paid API key is needed.
# LLM_API_KEY=
# Prefer `hf auth login`; the saved login is supported by diarization.
# HF_TOKEN=  # Optional override after accepting the selected model's terms.
