{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Voice-to-SOAP: unit tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {"PYTHONPATH": "${workspaceFolder}/src"}
      },
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Voice-to-SOAP: check setup",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["scripts/check_setup.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Voice-to-SOAP: inspect this computer",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["scripts/check_system.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
